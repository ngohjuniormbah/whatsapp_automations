# Copy to .env and fill in. NEVER commit .env.

# --- App ---
APP_ENV=development
# Public URL of THIS app (used later to verify Twilio's webhook signature).
# In dev this is your ngrok URL, e.g. https://abc123.ngrok-free.app
PUBLIC_BASE_URL=http://localhost:8000

# --- Database (matches docker-compose) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wa_agent
DB_ECHO=false

# --- LLM via OpenRouter (OpenAI-compatible) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3-30b-a3b

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio Sandbox sender in dev:
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
